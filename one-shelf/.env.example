# Copy to .env and load it with:  node --env-file=.env --disable-warning=ExperimentalWarning src/server.js
# (or export the variables in your host's dashboard). Never commit the real .env.

# development | test | production
NODE_ENV=development
PORT=3000
# Address to listen on. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
# Where the SQLite file and uploaded images live. Must be on a persistent disk in production.
DATA_DIR=./data
# The public address of the site, no trailing slash. Must be https:// in production.
PUBLIC_BASE_URL=http://localhost:3000

# demo | stripe.  "demo" takes no money and is refused in production (see below).
PAYMENT_PROVIDER=demo
# Only for a staging demo that runs with NODE_ENV=production. Leave unset on the real shop.
# ALLOW_DEMO_IN_PRODUCTION=yes
# Needed only when PAYMENT_PROVIDER=stripe (the Stripe provider is a stub until implemented).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Set to "yes" when the app runs behind a reverse proxy / load balancer that sets
# X-Forwarded-For, so rate limits see the real visitor address.
# TRUST_PROXY=yes

# Allow state-changing requests that carry neither an Origin nor a Referer header
# (curl, scripts). Defaults: yes in development and test, no in production.
# ALLOW_MISSING_ORIGIN=no

# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Rate limits (defaults shown).
# RATE_LIMIT_GLOBAL_MAX=300          # per IP per minute, everything
# RATE_LIMIT_LOGIN_MAX=5             # per IP + email per 15 minutes
# RATE_LIMIT_CHECKOUT_MAX=10         # per IP per minute
# RATE_LIMIT_SUBSCRIBE_MAX=5         # per IP per hour

# Minutes an unpaid order holds its stock before it expires.
# ORDER_EXPIRY_MINUTES=30

# Only read by scripts/create-admin.js for scripted use; otherwise it prompts.
# ADMIN_PASSWORD=
